# Set ONE of these to turn on AI features. Leave both empty for rules-only mode.
# If both are set, Gemini is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# seconds to keep retrying a busy AI before giving up
AI_TIME_BUDGET=30
ANTHROPIC_API_KEY=
SHIELD_MODEL=claude-sonnet-5-5
RATE_LIMIT=20
# MOCK_LLM=1   # canned AI replies, for testing the UI without a key
